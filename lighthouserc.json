{
	"ci": {
		"collect": {
			"startServerCommand": "pnpm preview --port 4173",
			"url": ["http://localhost:4173/"],
			"numberOfRuns": 3
		},
		"assert": {
			"aggregationMethod": "median",
			"assertions": {
				"categories:performance": [
					"error",
					{
						"minScore": 0.85
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 0.95
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 0.95
					}
				]
			}
		}
	}
}
